[Unit]
Description=DigitalPin Website (Next.js) – digitalpin.online
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/dolibarr/digitalpin-website
Environment=NODE_ENV=production
Environment=PORT=3220
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3220
Restart=always
RestartSec=5
User=www-data
Group=www-data
AmbientCapabilities=
NoNewPrivileges=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
